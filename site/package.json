{
  "name": "searchsdk-site",
  "private": true,
  "description": "The searchSDK website and documentation (Next.js App Router + Fumadocs).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "dev": "next dev --port 3210",
    "build": "next build",
    "start": "next start --port 3210",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "node checks/run.mjs",
    "check:examples": "node checks/examples.mjs"
  },
  "dependencies": {
    "fumadocs-core": "16.19.7",
    "fumadocs-mdx": "15.6.4",
    "fumadocs-ui": "16.19.7",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "parse5": "8.1.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild": false
  }
}
