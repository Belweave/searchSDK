{
  "name": "searchsdk-site",
  "private": true,
  "description": "The searchSDK website and documentation (Next.js App Router + Fumadocs).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "dev": "node checks/brand.mjs --write && node checks/mcp.mjs --write && next dev --port 3210",
    "build": "node checks/brand.mjs --write && node checks/mcp.mjs --write && next build",
    "start": "next start --port 3210",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "node checks/run.mjs",
    "check:examples": "node checks/examples.mjs",
    "brand:sync": "node checks/brand.mjs --write",
    "mcp:sync": "node checks/mcp.mjs --write",
    "reference": "node checks/reference.mjs --write"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "fumadocs-core": "16.19.7",
    "fumadocs-mdx": "15.6.4",
    "fumadocs-ui": "16.19.7",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ai": "7.0.182",
    "openai": "7.64.0",
    "parse5": "8.1.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild": false
  }
}
