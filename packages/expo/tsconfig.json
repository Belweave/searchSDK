{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@belweave/search-sdk-react-native": ["../react-native/dist/index.d.ts"]
    },
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "noEmitOnError": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
