{
  "$schema": "../schema/provider.schema.json",
  "formatVersion": 1,
  "id": "tinyfish",
  "name": "TinyFish",
  "specVersion": "2026-11-24",
  "sources": [
    { "url": "https://docs.tinyfish.ai/tinysearch/reference.md", "retrievedOn": "2026-11-24", "covers": "search parameters, response, status codes, rate limits, billing" },
    { "url": "https://docs.tinyfish.ai/search-api.md", "retrievedOn": "2026-11-24", "covers": "search overview, date filter rules, daily allowance" },
    { "url": "https://docs.tinyfish.ai/tinyfetch/reference.md", "retrievedOn": "2026-11-25", "covers": "fetch request, response, per-URL errors, billing" },
    { "url": "https://docs.tinyfish.ai/error-codes.md", "retrievedOn": "2026-11-24", "covers": "error envelope" },
    { "url": "https://www.tinyfish.ai/pricing", "retrievedOn": "2026-11-24", "covers": "prices and free limits" }
  ],
  "auth": { "in": "header", "name": "x-api-key", "env": ["TINYFISH_API_KEY"] },
  "capabilities": { "search": true, "contents": true, "answer": false, "research": true, "crawl": false },
  "index": { "type": "unknown", "note": "TinyFish does not state its index source; results are SERP-shaped (position, site_name)." },
  "terms": {
    "url": "https://www.tinyfish.ai/terms",
    "readOn": "2026-11-24",
    "benchmarkPublication": "not-addressed",
    "rawResponseStorage": "ask",
    "note": "Site Content may not be stored or compiled; whether that covers API output is unclear. Reading from the 2026-11-24 recon; not legal advice."
  },
  "errorCodePath": "error.code",
  "errors": [
    { "status": 429, "bodyPath": "error.details.reason", "equals": "free_allowance_exhausted", "code": "quota" }
  ],
  "search": {
    "verification": { "status": "unverified" },
    "request": {
      "method": "GET",
      "url": "https://api.search.tinyfish.ai",
      "encoding": "query",
      "fixed": {},
      "params": {
        "query": { "to": "query" },
        "includeDomains": { "to": "include_domains", "steps": [{ "step": "join", "separator": "," }] },
        "excludeDomains": { "to": "exclude_domains", "steps": [{ "step": "join", "separator": "," }] },
        "recency": { "to": "recency_minutes", "steps": [{ "step": "map-value", "table": { "day": 1440, "week": 10080, "month": 43200, "year": 525600 } }] },
        "startDate": { "to": "after_date" },
        "endDate": { "to": "before_date" },
        "country": { "to": "location", "steps": [{ "step": "uppercase" }] },
        "language": { "to": "language" }
      }
    },
    "limits": { "maxResults": 10, "maxQueryLength": null, "maxIncludeDomains": 100, "maxExcludeDomains": 100 },
    "dateBasis": "unknown",
    "response": {
      "results": "results",
      "excerptKind": "description",
      "fields": {
        "url": "url",
        "title": "title",
        "excerpts": { "path": "snippet", "steps": [{ "step": "to-list" }] },
        "publishedAt": { "path": "date", "steps": [{ "step": "parse-date" }] },
        "author": { "path": "authors", "steps": [{ "step": "join", "separator": ", " }] }
      },
      "providerFields": { "position": "position", "siteName": "site_name", "publisher": "publisher" },
      "requestId": [{ "header": "x-request-id" }]
    },
    "pricing": {
      "plan": "Free daily allowance",
      "source": "https://www.tinyfish.ai/pricing",
      "retrievedOn": "2026-11-24",
      "perRequestUsd": 0,
      "allowance": {
        "limit": 12000, "unit": "requests", "per": "day", "resetsAtUtc": "00:00", "source": "https://docs.tinyfish.ai/tinysearch/reference.md",
        "beyond": { "billing": "opt-in", "perRequestUsd": null, "refusal": "HTTP 429 RATE_LIMIT_EXCEEDED with details.reason free_allowance_exhausted" }
      },
      "note": "The pricing page lists Search at $0.00 per request. The API reference makes 12,000 requests a day free; past that, requests are refused unless wallet spending is enabled on the account, at a wallet price the docs do not state."
    },
    "rateLimits": [
      { "plan": "Personal", "limit": 30, "unit": "requests", "per": "minute", "scope": "person or organization", "source": "https://docs.tinyfish.ai/tinysearch/reference.md" },
      { "plan": "Personal", "limit": 500, "unit": "requests", "per": "hour", "scope": "person or organization", "source": "https://www.tinyfish.ai/pricing", "note": "on the pricing page only; the API reference gives no hourly limit" }
    ],
    "providerOptions": {
      "purpose": { "type": "string", "minLength": 1, "maxLength": 2000 },
      "domain_type": { "enum": ["web", "news", "research_paper"] },
      "page": { "type": "integer", "minimum": 0, "maximum": 10 },
      "pub_year_min": { "type": "integer", "minimum": 0, "maximum": 9999 },
      "pub_year_max": { "type": "integer", "minimum": 0, "maximum": 9999 }
    }
  },
  "contents": {
    "verification": { "status": "unverified" },
    "request": {
      "method": "POST",
      "url": "https://api.fetch.tinyfish.ai",
      "encoding": "json",
      "fixed": { "format": "markdown" },
      "params": { "urls": { "to": "urls" } }
    },
    "limits": { "maxUrls": 10 },
    "contentFormat": "markdown",
    "response": {
      "pages": [
        {
          "from": "results",
          "status": "ok",
          "fields": {
            "url": "url",
            "finalUrl": "final_url",
            "title": "title",
            "content": "text",
            "publishedAt": { "path": "published_date", "steps": [{ "step": "parse-date" }] },
            "author": "author"
          }
        },
        {
          "from": "errors",
          "optional": true,
          "status": "failed",
          "fields": { "url": "url", "errorCode": "error" }
        }
      ],
      "requestId": [{ "header": "x-request-id" }]
    },
    "pricing": {
      "plan": "Free daily allowance",
      "source": "https://www.tinyfish.ai/pricing",
      "retrievedOn": "2026-11-24",
      "perRequestUsd": 0,
      "allowance": {
        "limit": 1000, "unit": "urls", "per": "day", "resetsAtUtc": "00:00", "source": "https://docs.tinyfish.ai/tinyfetch/reference.md",
        "beyond": { "billing": "opt-in", "perRequestUsd": null, "refusal": "HTTP 429 RATE_LIMIT_EXCEEDED with details.reason free_allowance_exhausted" },
        "note": "Counted per successfully fetched URL."
      },
      "note": "The pricing page lists Fetch at $0.00 per URL. The API reference makes 1,000 fetched URLs a day free; past that, requests are refused unless wallet spending is enabled, at a wallet price the docs do not state."
    },
    "rateLimits": [
      { "plan": "Personal", "limit": 150, "unit": "urls", "per": "minute", "scope": "person or organization", "source": "https://docs.tinyfish.ai/tinyfetch/reference.md" }
    ],
    "providerOptions": {
      "purpose": { "type": "string", "minLength": 1, "maxLength": 2000 },
      "links": { "type": "boolean" },
      "image_links": { "type": "boolean" },
      "iframe_links": { "type": "boolean" },
      "ttl": { "type": "integer", "minimum": 0 },
      "per_url_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 110000 },
      "include_selectors": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
      "exclude_selectors": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
    }
  },
  "unverified": [
    { "pointer": "/search/limits/maxResults", "reason": "No result-count parameter is documented; examples return 10 per page. The runtime truncates." },
    { "pointer": "/search/limits/maxIncludeDomains", "reason": "No domain-list limit is documented; 100 is SDK policy." },
    { "pointer": "/search/limits/maxExcludeDomains", "reason": "No domain-list limit is documented; 100 is SDK policy." },
    { "pointer": "/search/response/fields/publishedAt", "reason": "date is 'present for news results and some web results'; its format is not documented." },
    { "pointer": "/search/dateBasis", "reason": "Docs do not say whether date filters use publish or crawl dates." },
    { "pointer": "/search/rateLimits/1", "reason": "The pricing page lists 500 requests per hour; the API reference lists only 30 per minute and the 12,000-a-day free allowance. Both are recorded; the strictest applies." },
    { "pointer": "/search/pricing/perRequestUsd", "reason": "$0.00 per the pricing page and free within the daily allowance per the API reference; no live bill has been checked." },
    { "pointer": "/search/pricing/allowance/beyond/perRequestUsd", "reason": "The wallet price past the allowance is not documented." },
    { "pointer": "/contents/pricing/perRequestUsd", "reason": "$0.00 per the pricing page and free within the daily allowance per the API reference; no live bill has been checked." },
    { "pointer": "/contents/pricing/allowance/beyond/perRequestUsd", "reason": "The wallet price past the allowance is not documented." },
    { "pointer": "/terms", "reason": "Terms reading taken from the 2026-11-24 recon, not re-read for this spec." }
  ]
}
