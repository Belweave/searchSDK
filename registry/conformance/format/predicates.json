          }
        }
      }
    },
    {
      "name": "booleans never equal numbers",
      "call": "contents",
      "urls": [
        "https://example.com/a"
      ],
      "options": {
        "provider": "predicates"
      },
      "responses": [
        {
          "status": 200,
