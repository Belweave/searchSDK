              "title": null,
              "content": "A",
              "publishedAt": null,
              "author": null,
              "error": null
            },
            {
              "url": "https://example.com/gone",
              "status": "failed",
              "finalUrl": null,
              "title": null,
              "content": null,
              "publishedAt": null,
              "author": null,
              "error": {
                "code": null,
                "message": "Target answered 404."
              }
            },
            {
              "url": "https://example.com/blocked",
              "status": "failed",
              "finalUrl": null,
              "title": null,
              "content": null,
              "publishedAt": null,
              "author": null,
              "error": {
                "code": "blocked",
                "message": null
              }
            },
            {
              "url": "https://example.com/odd",
              "status": "failed",
              "finalUrl": null,
              "title": null,
              "content": null,
              "publishedAt": null,
              "author": null,
              "error": {
                "code": "new_failure_type",
                "message": null
              }
            },
            {
              "url": "https://example.com/nocode",
              "status": "failed",
              "finalUrl": null,
              "title": null,
              "content": null,
              "publishedAt": null,
              "author": null,
              "error": {
                "code": null,
                "message": null
              }
            },
            {
              "url": "https://example.com/skipped",
              "status": "failed",
              "finalUrl": null,
              "title": null,
              "content": null,
              "publishedAt": null,
              "author": null,
              "error": {
                "code": "robots",
                "message": null
              }
            }
          ],
          "warnings": [
            {
              "code": "provider_warning",
              "provider": "predicates",
