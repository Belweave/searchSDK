  },
  "cases": [
    {
      "name": "scalars serialize in a fixed form and order",
      "call": "search",
      "query": "q",
      "options": {
        "provider": "query-string"
      },
      "responses": [
        {
          "status": 200,
          "body": {
            "results": []
          }
        }
      ],
      "expect": {
        "requests": [
          {
            "url": "https://api.example.com/search?flag=false&on=true&n=10&two=2&half=0.5&big=1e%2B21&tiny=1e-7&neg=-3&s=a%20b%2Fc&query=q"
          }
        ]
      }
    },
    {
      "name": "a provider option replacing a fixed key keeps its place",
      "call": "search",
      "query": "q",
      "options": {
        "provider": "query-string",
        "providerOptions": {
          "query-string": {
            "n": 20
          }
        }
      },
      "responses": [
        {
          "status": 200,
          "body": {
            "results": []
          }
        }
      ],
      "expect": {
        "requests": [
          {
            "url": "https://api.example.com/search?flag=false&on=true&n=20&two=2&half=0.5&big=1e%2B21&tiny=1e-7&neg=-3&s=a%20b%2Fc&query=q"
          }
        ]
      }
    },
    {
      "name": "an array cannot be sent in a query string",
      "call": "search",
      "query": "q",
      "options": {
        "provider": "query-string",
        "providerOptions": {
          "query-string": {
            "list": [
              "a"
            ]
          }
        }
      },
      "expect": {
        "requestCount": 0,
        "error": {
          "code": "invalid_request",
          "provider": "query-string",
          "field": "providerOptions.query-string.list"
        }
      }
    },
    {
      "name": "a param value a query string cannot carry makes the provider unsupported for that input",
      "call": "search",
      "query": "q",
      "options": {
        "provider": "query-list",
        "includeDomains": [
          "a.example"
        ]
      },
      "expect": {
        "requestCount": 0,
        "error": {
          "code": "unsupported",
          "provider": "query-list",
          "field": "includeDomains"
        }
      }
    },
    {
      "name": "so a fallback that can carry it is used",
      "call": "search",
      "query": "q",
      "options": {
        "provider": "query-list",
        "fallback": [
          "json-list"
        ],
        "includeDomains": [
          "a.example"
        ]
      },
      "responses": [
        {
          "status": 200,
          "body": {
            "results": []
          }
        }
      ],
      "expect": {
        "requests": [
          {
            "method": "POST",
            "url": "https://api.example.com/list",
            "body": {
              "q": "q",
              "site": [
                "a.example"
              ]
            }
          }
        ],
        "responseIncludes": {
          "provider": "json-list"
        }
      }
    }
  ]
}
