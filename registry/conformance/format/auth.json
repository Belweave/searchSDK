{
  "description": "Key placement (policy.md, Requests). A header key goes in its header. A query key is appended to the URL as the last query parameter for every encoding, JSON bodies included, and never appears in an error.",
  "synthetic": "Synthetic: format vectors use invented specs and bodies; no provider is described.",
  "providers": {
    "query-auth": {
      "formatVersion": 1,
      "id": "query-auth",
      "name": "Synthetic query-auth",
      "specVersion": "2026-11-24",
      "sources": [
        {
          "url": "https://example.com/docs",
          "retrievedOn": "2026-11-24",
          "covers": "nothing; synthetic spec for format vectors"
        }
      ],
      "auth": {
        "in": "query",
        "name": "api_key",
        "env": [
          "SYNTHETIC_API_KEY"
        ],
        "keyInUrlReason": "Synthetic: exercises query auth on a JSON request."
      },
      "capabilities": {
        "search": true,
        "contents": false
      },
      "index": {
        "type": "unknown"
      },
      "terms": {
        "url": "https://example.com/terms",
        "readOn": "2026-11-24",
        "benchmarkPublication": "not-addressed",
        "rawResponseStorage": "not-addressed"
      },
      "errors": [],
      "search": {
        "verification": { "status": "unverified" },
        "request": {
          "method": "POST",
          "url": "https://api.example.com/search",
          "encoding": "json",
          "params": {
            "query": {
              "to": "query"
            }
          }
        },
        "limits": {
          "maxResults": 20,
          "maxQueryLength": null,
          "maxIncludeDomains": 10,
          "maxExcludeDomains": 10
        },
        "dateBasis": "published",
        "response": {
          "results": "results",
          "excerptKind": "none",
          "fields": {
            "url": "url",
            "title": "title"
          }
        },
        "pricing": {
          "plan": "Synthetic",
          "source": "https://example.com/pricing",
          "retrievedOn": "2026-11-24",
          "perRequestUsd": 0.005
        },
        "rateLimits": [],
        "providerOptions": {}
      },
      "unverified": []
    },
    "query-auth-get": {
      "formatVersion": 1,
      "id": "query-auth-get",
      "name": "Synthetic query-auth-get",
      "specVersion": "2026-11-24",
      "sources": [
        {
          "url": "https://example.com/docs",
          "retrievedOn": "2026-11-24",
          "covers": "nothing; synthetic spec for format vectors"
        }
      ],
      "auth": {
        "in": "query",
        "name": "key",
        "env": [
          "SYNTHETIC_GET_KEY"
        ],
        "keyInUrlReason": "Synthetic: exercises query auth on a GET request."
      },
      "capabilities": {
        "search": true,
        "contents": false
      },
      "index": {
        "type": "unknown"
      },
      "terms": {
        "url": "https://example.com/terms",
        "readOn": "2026-11-24",
        "benchmarkPublication": "not-addressed",
        "rawResponseStorage": "not-addressed"
      },
      "errors": [],
      "search": {
        "verification": { "status": "unverified" },
        "request": {
          "method": "GET",
          "url": "https://api.example.com/search?v=1",
          "encoding": "query",
          "params": {
            "query": {
              "to": "q"
            }
          }
        },
        "limits": {
          "maxResults": 20,
          "maxQueryLength": null,
          "maxIncludeDomains": 10,
          "maxExcludeDomains": 10
        },
        "dateBasis": "published",
        "response": {
          "results": "results",
          "excerptKind": "none",
          "fields": {
            "url": "url",
            "title": "title"
          }
        },
        "pricing": {
          "plan": "Synthetic",
          "source": "https://example.com/pricing",
          "retrievedOn": "2026-11-24",
          "perRequestUsd": 0.005
        },
        "rateLimits": [],
        "providerOptions": {}
      },
      "unverified": []
    }
  },
  "cases": [
    {
      "name": "a query key is appended to the URL of a JSON request",
      "call": "search",
      "query": "q",
      "options": {
        "provider": "query-auth"
      },
      "responses": [
        {
          "status": 200,
          "body": {
            "results": []
          }
        }
      ],
      "expect": {
        "requests": [
          {
            "method": "POST",
            "url": "https://api.example.com/search?api_key=test-key-query-auth",
            "headers": {
              "accept": "application/json",
              "content-type": "application/json"
            },
            "body": {
              "query": "q"
            }
          }
        ]
      }
    },
    {
      "name": "a query key is the last parameter of a GET and is percent-encoded",
      "call": "search",
      "query": "a b",
      "options": {
        "provider": "query-auth-get"
      },
      "client": {
        "keys": {
          "query-auth-get": "k+/=~"
        }
      },
      "responses": [
        {
          "status": 200,
          "body": {
            "results": []
          }
        }
      ],
      "expect": {
        "requests": [
          {
            "method": "GET",
            "url": "https://api.example.com/search?v=1&q=a%20b&key=k%2B%2F%3D~",
            "headers": {
              "accept": "application/json"
            },
            "body": null
          }
        ]
      }
    },
    {
      "name": "a query key never appears in an error",
      "call": "search",
      "query": "q",
      "options": {
        "provider": "query-auth"
      },
      "client": {
        "keys": {
          "query-auth": "secret-in-url-must-not-leak"
        }
      },
      "responses": [
        {
          "network": true
        }
      ],
      "expect": {
        "error": {
          "code": "network",
          "provider": "query-auth"
        },
        "secretAbsent": "secret-in-url-must-not-leak"
      }
    }
  ]
}
