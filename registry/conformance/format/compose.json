{
  "description": "Values built from several inputs (schema: request.compose). A compose entry applies when any of its inputs is set. Text parts are always emitted; an input part emits its text and then its value after steps; an absent input emits nothing unless it is required, which makes the request unsupported for that input. The result is one string at the target path, which provider options may not replace.",
  "synthetic": "Synthetic: format vectors use invented specs and bodies; no provider is described.",
  "providers": {
    "range-both": {
      "formatVersion": 1,
      "id": "range-both",
      "name": "Synthetic range-both",
      "specVersion": "2026-11-24",
      "sources": [
        {
          "url": "https://example.com/docs",
          "retrievedOn": "2026-11-24",
          "covers": "nothing; synthetic spec for format vectors"
        }
      ],
      "auth": {
        "in": "header",
        "name": "x-api-key",
        "env": [
          "SYNTHETIC_API_KEY"
        ]
      },
      "capabilities": {
        "search": true,
        "contents": false
      },
      "index": {
        "type": "unknown"
      },
      "terms": {
        "url": "https://example.com/terms",
        "readOn": "2026-11-24",
        "benchmarkPublication": "not-addressed",
        "rawResponseStorage": "not-addressed"
      },
      "errors": [],
      "search": {
        "request": {
          "method": "POST",
          "url": "https://api.example.com/search",
          "encoding": "json",
          "params": {
            "query": {
              "to": "q"
            },
            "recency": {
              "to": "freshness",
              "steps": [
                {
                  "step": "map-value",
                  "table": {
                    "day": "pd",
                    "week": "pw",
                    "month": "pm",
                    "year": "py"
                  }
                }
              ]
            }
          },
          "compose": [
            {
              "to": "freshness",
              "parts": [
                {
                  "input": "startDate",
                  "required": true
                },
                {
                  "text": "to"
                },
                {
                  "input": "endDate",
                  "required": true
                }
              ]
            }
          ]
        },
        "limits": {
          "maxResults": 20,
          "maxQueryLength": null,
          "maxIncludeDomains": 10,
          "maxExcludeDomains": 10
        },
        "dateBasis": "published",
        "response": {
          "results": "results",
          "fields": {
            "url": "url",
            "title": "title"
          }
        },
        "pricing": {
          "plan": "Synthetic",
          "source": "https://example.com/pricing",
          "retrievedOn": "2026-11-24",
          "perRequestUsd": 0.005
        },
        "rateLimits": [],
        "providerOptions": {}
      },
      "unverified": []
    },
    "range-either": {
      "formatVersion": 1,
      "id": "range-either",
      "name": "Synthetic range-either",
      "specVersion": "2026-11-24",
      "sources": [
        {
          "url": "https://example.com/docs",
          "retrievedOn": "2026-11-24",
          "covers": "nothing; synthetic spec for format vectors"
        }
      ],
      "auth": {
        "in": "header",
        "name": "x-api-key",
        "env": [
          "SYNTHETIC_API_KEY"
        ]
      },
      "capabilities": {
        "search": true,
        "contents": false
      },
      "index": {
        "type": "unknown"
      },
      "terms": {
        "url": "https://example.com/terms",
        "readOn": "2026-11-24",
        "benchmarkPublication": "not-addressed",
        "rawResponseStorage": "not-addressed"
      },
      "errors": [],
      "search": {
        "request": {
          "method": "GET",
          "url": "https://api.example.com/search",
          "encoding": "query",
          "params": {
            "query": {
              "to": "q"
            },
            "recency": {
              "to": "tbs",
              "steps": [
                {
                  "step": "map-value",
                  "table": {
                    "day": "qdr:d",
                    "week": "qdr:w",
                    "month": "qdr:m",
                    "year": "qdr:y"
                  }
                }
              ]
            }
          },
          "compose": [
            {
              "to": "tbs",
              "parts": [
                {
                  "text": "cdr:1"
                },
                {
                  "input": "startDate",
                  "text": ",cd_min:",
                  "steps": [
                    {
                      "step": "format-date",
                      "format": "MM/DD/YYYY"
                    }
                  ]
                },
                {
                  "input": "endDate",
                  "text": ",cd_max:",
                  "steps": [
                    {
                      "step": "format-date",
                      "format": "MM/DD/YYYY"
                    }
                  ]
                }
              ]
            }
          ]
        },
        "limits": {
          "maxResults": 20,
          "maxQueryLength": null,
          "maxIncludeDomains": 10,
          "maxExcludeDomains": 10
        },
        "dateBasis": "published",
        "response": {
          "results": "results",
          "fields": {
            "url": "url",
            "title": "title"
          }
        },
        "pricing": {
          "plan": "Synthetic",
          "source": "https://example.com/pricing",
          "retrievedOn": "2026-11-24",
          "perRequestUsd": 0.005
        },
        "rateLimits": [],
        "providerOptions": {
          "tbs": {
            "type": "string"
          }
        }
      },
      "unverified": []
    }
  },
  "cases": [
    {
      "name": "two dates become one range string",
      "call": "search",
      "query": "q",
      "options": {
        "provider": "range-both",
        "startDate": "2026-01-01",
        "endDate": "2026-01-31"
      },
      "responses": [
        {
          "status": 200,
          "body": {
            "results": []
          }
        }
      ],
      "expect": {
        "requests": [
          {
            "body": {
              "q": "q",
              "freshness": "2026-01-01to2026-01-31"
            }
          }
        ]
      }
    },
    {
      "name": "a missing required input is unsupported for that input and nothing is sent",
      "call": "search",
      "query": "q",
      "options": {
        "provider": "range-both",
        "startDate": "2026-01-01"
      },
      "expect": {
        "requestCount": 0,
        "error": {
          "code": "unsupported",
          "provider": "range-both",
          "field": "endDate"
        }
      }
    },
    {
      "name": "an unsupported range falls back to a provider that can express it",
      "call": "search",
      "query": "q",
      "options": {
        "provider": "range-both",
        "fallback": [
          "range-either"
        ],
        "startDate": "2026-01-01"
      },
      "responses": [
        {
          "status": 200,
          "body": {
            "results": []
          }
        }
      ],
      "expect": {
        "requests": [
          {
            "method": "GET",
            "url": "https://api.example.com/search?q=q&tbs=cdr%3A1%2Ccd_min%3A01%2F01%2F2026"
          }
        ]
      }
    },
    {
      "name": "optional parts are left out when their input is absent",
      "call": "search",
      "query": "q",
      "options": {
        "provider": "range-either",
        "endDate": "2026-12-05"
      },
      "responses": [
        {
          "status": 200,
          "body": {
            "results": []
          }
        }
      ],
      "expect": {
        "requests": [
          {
            "url": "https://api.example.com/search?q=q&tbs=cdr%3A1%2Ccd_max%3A12%2F05%2F2026"
          }
        ]
      }
    },
    {
      "name": "both optional parts in order",
      "call": "search",
      "query": "q",
      "options": {
        "provider": "range-either",
        "startDate": "2025-02-03",
        "endDate": "2026-12-05"
      },
      "responses": [
        {
          "status": 200,
          "body": {
            "results": []
          }
        }
      ],
      "expect": {
        "requests": [
          {
            "url": "https://api.example.com/search?q=q&tbs=cdr%3A1%2Ccd_min%3A02%2F03%2F2025%2Ccd_max%3A12%2F05%2F2026"
          }
        ]
      }
    },
    {
      "name": "with no input set, a compose entry sends nothing",
      "call": "search",
      "query": "q",
      "options": {
        "provider": "range-either"
      },
      "responses": [
        {
          "status": 200,
          "body": {
            "results": []
          }
        }
      ],
      "expect": {
        "requests": [
          {
            "url": "https://api.example.com/search?q=q"
          }
        ]
      }
    },
    {
      "name": "a param may target the same path when the inputs are exclusive",
      "call": "search",
      "query": "q",
      "options": {
        "provider": "range-either",
        "recency": "week"
      },
      "responses": [
        {
          "status": 200,
          "body": {
            "results": []
          }
        }
      ],
      "expect": {
        "requests": [
          {
            "url": "https://api.example.com/search?q=q&tbs=qdr%3Aw"
          }
        ]
      }
    },
    {
      "name": "a provider option may not replace a composed value",
      "call": "search",
      "query": "q",
      "options": {
        "provider": "range-either",
        "startDate": "2026-01-01",
        "providerOptions": {
          "range-either": {
            "tbs": "sbd:1"
          }
        }
      },
      "expect": {
        "requestCount": 0,
        "error": {
          "code": "invalid_request",
          "provider": "range-either",
          "field": "providerOptions.range-either.tbs"
        }
      }
    },
    {
      "name": "a provider option may set the target when no input is set",
      "call": "search",
      "query": "q",
      "options": {
        "provider": "range-either",
        "providerOptions": {
          "range-either": {
            "tbs": "sbd:1"
          }
        }
      },
      "responses": [
        {
          "status": 200,
          "body": {
            "results": []
          }
        }
      ],
      "expect": {
        "requests": [
          {
            "url": "https://api.example.com/search?q=q&tbs=sbd%3A1"
          }
        ]
      }
    }
  ]
}
