    },
    {
      "name": "433 pay-as-you-go limit maps to quota",
      "call": "search",
      "query": "x",
      "options": { "provider": "tavily" },
      "responses": [{ "status": 433, "body": { "detail": { "error": "Synthetic paygo limit." } } }],
      "expect": { "error": { "code": "quota", "provider": "tavily", "status": 433 } }
