      "query": "sqlite wal",
      "options": {
        "provider": "tavily",
        "maxResults": 3,
        "includeDomains": ["sqlite.org", "example.org"],
        "recency": "month",
        "country": "gb",
        "language": "EN",
        "depth": "deep"
      },
      "responses": [
        {
          "status": 200,
          "body": {
            "query": "sqlite wal",
            "answer": null,
            "images": [],
            "results": [
              {
                "title": "WAL",
                "url": "https://sqlite.org/wal.html",
                "content": "Synthetic chunk one. [...] Synthetic chunk two.",
                "score": 0.81,
                "published_date": "Tue, 11 Mar 2025 17:00:00 GMT",
                "favicon": "https://sqlite.org/favicon.ico"
              },
              { "title": "Bad row", "url": "ftp://example.org/file", "content": "dropped", "score": 0.5 },
              { "title": "   ", "url": "https://example.org/a", "content": "", "score": 0.2, "published_date": null }
