              "include_published_date": true,
              "include_answer": false,
              "include_raw_content": false,
              "auto_parameters": false,
              "query": "sqlite wal",
              "max_results": 3,
              "include_domains": ["sqlite.org", "example.org"],
              "time_range": "month",
              "country": "united kingdom",
              "language": "en"
            }
          }
        ],
        "response": {
          "provider": "tavily",
          "results": [
            {
              "url": "https://sqlite.org/wal.html",
              "title": "WAL",
              "excerpts": ["Synthetic chunk one. [...] Synthetic chunk two."],
