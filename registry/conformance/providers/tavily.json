          ],
          "cost": { "usd": 0.016, "estimated": true, "source": "reported-credits", "credits": 2 },
          "requestId": "synthetic-tavily-1",
          "latencyMs": 0,
          "warnings": [{ "code": "invalid_rows_dropped", "provider": "tavily", "count": 1 }],
          "attempts": [{ "provider": "tavily", "outcome": "ok", "status": 200, "startMs": 0, "durationMs": 0 }]
