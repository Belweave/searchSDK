{
  "description": "Input and configuration validation. Invalid input fails before any request; valid input is shown by the request it produces.",
  "defaults": {
    "options": { "provider": "exa" },
    "responses": [{ "status": 200, "body": { "results": [] } }]
  },
  "cases": [
    { "name": "empty query", "call": "search", "query": "", "expect": { "requestCount": 0, "error": { "code": "invalid_request", "field": "query" } } },
    { "name": "ASCII whitespace-only query", "call": "search", "query": " \t\n\r\u000b\u000c", "expect": { "requestCount": 0, "error": { "code": "invalid_request", "field": "query" } } },
    { "name": "NBSP and ideographic space only", "call": "search", "query": " 　", "expect": { "requestCount": 0, "error": { "code": "invalid_request", "field": "query" } } },
    { "name": "BOM only (JS trim treats it as blank, Python strip does not)", "call": "search", "query": "﻿", "expect": { "requestCount": 0, "error": { "code": "invalid_request", "field": "query" } } },
    { "name": "NEL only (Python strip treats it as blank, JS trim does not)", "call": "search", "query": "\u0085", "expect": { "requestCount": 0, "error": { "code": "invalid_request", "field": "query" } } },
    { "name": "zero-width characters only", "call": "search", "query": "​‌‍⁠᠎", "expect": { "requestCount": 0, "error": { "code": "invalid_request", "field": "query" } } },
    { "name": "line and paragraph separators only", "call": "search", "query": "     ", "expect": { "requestCount": 0, "error": { "code": "invalid_request", "field": "query" } } },
    { "name": "U+001F alone is forbidden, not blank (Python strip treats it as blank)", "call": "search", "query": "\u001f", "expect": { "requestCount": 0, "error": { "code": "invalid_request", "field": "query" } } },
    { "name": "NUL inside a query", "call": "search", "query": "a\u0000b", "expect": { "requestCount": 0, "error": { "code": "invalid_request", "field": "query" } } },
    { "name": "C1 control inside a query", "call": "search", "query": "a\u0090b", "expect": { "requestCount": 0, "error": { "code": "invalid_request", "field": "query" } } },
    { "name": "DEL inside a query", "call": "search", "query": "a\u007fb", "expect": { "requestCount": 0, "error": { "code": "invalid_request", "field": "query" } } },
    { "name": "unpaired surrogate", "call": "search", "query": "a\ud800b", "expect": { "requestCount": 0, "error": { "code": "invalid_request", "field": "query" } } },
    { "name": "non-string query", "call": "search", "query": 42, "expect": { "requestCount": 0, "error": { "code": "invalid_request", "field": "query" } } },
    { "name": "blank code points are trimmed from both ends only", "call": "search", "query": "　 hello world ﻿​", "expect": { "requests": [{ "bodyIncludes": { "query": "hello world" } }] } },
    { "name": "inner tab and newline are kept", "call": "search", "query": "a\tb\nc", "expect": { "requests": [{ "bodyIncludes": { "query": "a\tb\nc" } }] } },
    { "name": "astral characters count as one code point", "call": "search", "query": { "$repeat": "😀", "count": 2000 }, "expect": { "requestCount": 1 } },
    { "name": "2001 code points is too long", "call": "search", "query": { "$repeat": "a", "count": 2001 }, "expect": { "requestCount": 0, "error": { "code": "invalid_request", "field": "query" } } },
    { "name": "length is counted after trimming", "call": "search", "query": { "$repeat": "a", "count": 2000, "prefix": "   ", "suffix": "　" }, "expect": { "requestCount": 1 } },
    { "name": "unknown search option (typo)", "call": "search", "query": "q", "options": { "maxResult": 5 }, "expect": { "requestCount": 0, "error": { "code": "invalid_request", "field": "maxResult" } } },
    { "name": "search option not valid for contents", "call": "contents", "urls": ["https://example.com/"], "options": { "maxResults": 5 }, "expect": { "requestCount": 0, "error": { "code": "invalid_request", "field": "maxResults" } } },
    { "name": "default maxResults", "call": "search", "query": "q", "expect": { "requests": [{ "bodyIncludes": { "numResults": 10 } }] } },
    { "name": "maxResults 0", "call": "search", "query": "q", "options": { "maxResults": 0 }, "expect": { "error": { "code": "invalid_request", "field": "maxResults" } } },
    { "name": "maxResults 101", "call": "search", "query": "q", "options": { "maxResults": 101 }, "expect": { "error": { "code": "invalid_request", "field": "maxResults" } } },
    { "name": "maxResults fractional", "call": "search", "query": "q", "options": { "maxResults": 1.5 }, "expect": { "error": { "code": "invalid_request", "field": "maxResults" } } },
    { "name": "maxResults string", "call": "search", "query": "q", "options": { "maxResults": "5" }, "expect": { "error": { "code": "invalid_request", "field": "maxResults" } } },
    { "name": "maxResults 100 on Exa", "call": "search", "query": "q", "options": { "maxResults": 100 }, "expect": { "requests": [{ "bodyIncludes": { "numResults": 100 } }] } },
    { "name": "domains are ASCII-lowercased and deduplicated", "call": "search", "query": "q", "options": { "includeDomains": ["Example.COM", "example.com", "xn--bcher-kva.example", "a.b.c.example.org"] }, "expect": { "requests": [{ "bodyIncludes": { "includeDomains": ["example.com", "xn--bcher-kva.example", "a.b.c.example.org"] } }] } },
    { "name": "an empty domain list means no filter", "call": "search", "query": "q", "options": { "includeDomains": [] }, "expect": { "requests": [{ "body": { "type": "auto", "contents": { "highlights": true }, "query": "q", "numResults": 10 } }] } },
    { "name": "single-label domain", "call": "search", "query": "q", "options": { "includeDomains": ["localhost"] }, "expect": { "error": { "code": "invalid_request", "field": "includeDomains" } } },
    { "name": "domain with a space", "call": "search", "query": "q", "options": { "includeDomains": ["exa mple.com"] }, "expect": { "error": { "code": "invalid_request", "field": "includeDomains" } } },
    { "name": "domain label starting with a hyphen", "call": "search", "query": "q", "options": { "excludeDomains": ["-bad.com"] }, "expect": { "error": { "code": "invalid_request", "field": "excludeDomains" } } },
    { "name": "non-ASCII domain (use punycode)", "call": "search", "query": "q", "options": { "includeDomains": ["bücher.example"] }, "expect": { "error": { "code": "invalid_request", "field": "includeDomains" } } },
    { "name": "domain with a path", "call": "search", "query": "q", "options": { "includeDomains": ["example.com/docs"] }, "expect": { "error": { "code": "invalid_request", "field": "includeDomains" } } },
    { "name": "domain listed in both include and exclude", "call": "search", "query": "q", "options": { "includeDomains": ["a.com"], "excludeDomains": ["A.com"] }, "expect": { "error": { "code": "invalid_request", "field": "excludeDomains" } } },
    { "name": "unknown recency", "call": "search", "query": "q", "options": { "recency": "fortnight" }, "expect": { "error": { "code": "invalid_request", "field": "recency" } } },
    { "name": "recency with a date range", "call": "search", "query": "q", "options": { "recency": "day", "endDate": "2026-01-01" }, "expect": { "error": { "code": "invalid_request", "field": "recency" } } },
    { "name": "29 February in a common year", "call": "search", "query": "q", "options": { "startDate": "2025-02-29" }, "expect": { "error": { "code": "invalid_request", "field": "startDate" } } },
    { "name": "29 February in a leap year", "call": "search", "query": "q", "options": { "startDate": "2024-02-29" }, "expect": { "requests": [{ "bodyIncludes": { "startPublishedDate": "2024-02-29T00:00:00.000Z" } }] } },
    { "name": "unpadded date", "call": "search", "query": "q", "options": { "startDate": "2024-2-1" }, "expect": { "error": { "code": "invalid_request", "field": "startDate" } } },
    { "name": "start after end", "call": "search", "query": "q", "options": { "startDate": "2026-02-01", "endDate": "2026-01-31" }, "expect": { "error": { "code": "invalid_request", "field": "endDate" } } },
    { "name": "three-letter country", "call": "search", "query": "q", "options": { "country": "usa" }, "expect": { "error": { "code": "invalid_request", "field": "country" } } },
    { "name": "three-letter language", "call": "search", "query": "q", "options": { "language": "eng" }, "expect": { "error": { "code": "invalid_request", "field": "language" } } },
    { "name": "unknown depth", "call": "search", "query": "q", "options": { "depth": "max" }, "expect": { "error": { "code": "invalid_request", "field": "depth" } } },
    { "name": "timeout 0", "call": "search", "query": "q", "options": { "timeoutMs": 0 }, "expect": { "error": { "code": "invalid_request", "field": "timeoutMs" } } },
    { "name": "timeout above maximum", "call": "search", "query": "q", "options": { "timeoutMs": 300001 }, "expect": { "error": { "code": "invalid_request", "field": "timeoutMs" } } },
    { "name": "six retries", "call": "search", "query": "q", "options": { "maxRetries": 6 }, "expect": { "error": { "code": "invalid_request", "field": "maxRetries" } } },
    { "name": "response limit below minimum", "call": "search", "query": "q", "options": { "maxResponseBytes": 1023 }, "expect": { "error": { "code": "invalid_request", "field": "maxResponseBytes" } } },
    { "name": "no provider", "call": "search", "query": "q", "options": { "provider": null }, "expect": { "requestCount": 0, "error": { "code": "configuration", "field": "provider" } } },
    { "name": "unknown provider", "call": "search", "query": "q", "options": { "provider": "bing" }, "expect": { "error": { "code": "configuration", "field": "provider" } } },
    { "name": "a provider is tried once even if the fallback repeats it", "call": "search", "query": "q", "options": { "fallback": ["exa", "tavily", "exa"] }, "responses": [{ "status": 503 }, { "status": 503 }], "expect": { "requests": [{ "url": "https://api.exa.ai/search" }, { "url": "https://api.tavily.com/search" }], "error": { "code": "unavailable", "provider": "tavily" } } },
    { "name": "fallback must list known providers", "call": "search", "query": "q", "options": { "fallback": ["exa", "bing"] }, "expect": { "requestCount": 0, "error": { "code": "configuration", "field": "fallback" } } },
    { "name": "missing key", "call": "search", "query": "q", "client": { "keys": {}, "env": {} }, "expect": { "requestCount": 0, "error": { "code": "configuration", "provider": "exa", "field": "keys" } } },
    { "name": "key with a space", "call": "search", "query": "q", "client": { "keys": { "exa": "abc def" } }, "expect": { "error": { "code": "configuration", "provider": "exa", "field": "keys" } } },
    { "name": "key with a newline (header injection)", "call": "search", "query": "q", "client": { "keys": { "exa": "abc\r\nx-evil: 1" } }, "expect": { "error": { "code": "configuration", "provider": "exa", "field": "keys" } } },
    { "name": "key from the documented environment variable", "call": "search", "query": "q", "client": { "keys": {}, "env": { "EXA_API_KEY": "env-key-exa" } }, "expect": { "requests": [{ "headers": { "accept": "application/json", "content-type": "application/json", "x-api-key": "env-key-exa" } }] } },
    { "name": "a missing fallback key fails before any request", "call": "search", "query": "q", "options": { "fallback": ["tavily"] }, "client": { "keys": { "exa": "k" }, "env": {} }, "expect": { "requestCount": 0, "error": { "code": "configuration", "provider": "tavily", "field": "keys" } } },
    { "name": "undeclared provider option", "call": "search", "query": "q", "options": { "providerOptions": { "exa": { "foo": 1 } } }, "expect": { "requestCount": 0, "error": { "code": "invalid_request", "provider": "exa", "field": "providerOptions.exa.foo" } } },
    { "name": "provider option of the wrong type", "call": "search", "query": "q", "options": { "providerOptions": { "exa": { "moderation": "yes" } } }, "expect": { "error": { "code": "invalid_request", "provider": "exa", "field": "providerOptions.exa.moderation" } } },
    { "name": "provider option colliding with a normalized option", "call": "search", "query": "q", "options": { "depth": "deep", "providerOptions": { "exa": { "type": "auto" } } }, "expect": { "error": { "code": "invalid_request", "provider": "exa", "field": "providerOptions.exa.type" } } },
    { "name": "provider option may replace a fixed default", "call": "search", "query": "q", "options": { "providerOptions": { "exa": { "type": "lite" } } }, "expect": { "requests": [{ "bodyIncludes": { "type": "lite" } }] } },
    { "name": "provider options for an unknown provider", "call": "search", "query": "q", "options": { "providerOptions": { "bing": {} } }, "expect": { "error": { "code": "configuration", "field": "providerOptions" } } },
    { "name": "auth headers cannot be set through provider options", "call": "search", "query": "q", "options": { "provider": "tavily", "providerOptions": { "tavily": { "authorization": "Bearer other" } } }, "expect": { "requestCount": 0, "error": { "code": "invalid_request", "provider": "tavily", "field": "providerOptions.tavily.authorization" } } },
    { "name": "contents with no URLs", "call": "contents", "urls": [], "expect": { "error": { "code": "invalid_request", "field": "urls" } } },
    { "name": "contents with a non-HTTP URL", "call": "contents", "urls": ["ftp://example.com/x"], "expect": { "error": { "code": "invalid_request", "field": "urls" } } },
    { "name": "contents with credentials in the URL", "call": "contents", "urls": ["https://user:pw@example.com/"], "expect": { "error": { "code": "invalid_request", "field": "urls" } } },
    { "name": "contents with a space in the URL", "call": "contents", "urls": ["https://example.com/a b"], "expect": { "error": { "code": "invalid_request", "field": "urls" } } },
    { "name": "contents with duplicate URLs after normalization", "call": "contents", "urls": ["https://Example.com", "https://example.com:443/"], "expect": { "error": { "code": "invalid_request", "field": "urls" } } },
    { "name": "contents URL over 2048 characters", "call": "contents", "urls": [{ "$repeat": "a", "count": 2030, "prefix": "https://example.com/" }], "expect": { "error": { "code": "invalid_request", "field": "urls" } } },
    { "name": "contents with 101 URLs", "call": "contents", "urls": { "$urls": 101 }, "expect": { "error": { "code": "invalid_request", "field": "urls" } } },
    { "name": "contents accepts one URL as a string", "call": "contents", "urls": "https://example.com/x", "responses": [{ "status": 200, "body": { "results": [], "statuses": [] } }], "expect": { "requests": [{ "bodyIncludes": { "urls": ["https://example.com/x"] } }] } }
  ]
}
