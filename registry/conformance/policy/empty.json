{
  "description": "Empty results are a success, never an error or a reason to fall back. A missing or non-array result list is invalid_response.",
  "cases": [
    { "name": "exa empty", "call": "search", "query": "q", "options": { "provider": "exa", "fallback": ["tavily"] }, "responses": [{ "status": 200, "body": { "results": [] } }], "expect": { "requestCount": 1, "responseIncludes": { "provider": "exa", "results": [], "warnings": [] } } },
    { "name": "tavily empty", "call": "search", "query": "q", "options": { "provider": "tavily" }, "responses": [{ "status": 200, "body": { "results": [], "images": [], "answer": null, "query": "q", "response_time": 0.1 } }], "expect": { "responseIncludes": { "results": [], "warnings": [] } } },
    { "name": "context empty", "call": "search", "query": "q", "options": { "provider": "context" }, "responses": [{ "status": 200, "body": { "results": [], "query": "q", "cache_metadata": { "status": "miss", "age_ms": 0 }, "request_id": "r" } }], "expect": { "responseIncludes": { "results": [], "warnings": [], "cost": { "usd": 0, "estimated": true, "source": "computed" } } } },
    { "name": "tinyfish empty", "call": "search", "query": "q", "options": { "provider": "tinyfish" }, "responses": [{ "status": 200, "body": { "query": "q", "results": [], "total_results": 0, "page": 0 } }], "expect": { "responseIncludes": { "results": [], "warnings": [] } } },
    { "name": "every row invalid gives empty results and a warning", "call": "search", "query": "q", "options": { "provider": "exa" }, "responses": [{ "status": 200, "body": { "results": [{ "title": "no url" }, { "url": "javascript:alert(1)" }, { "url": "https://" }] } }], "expect": { "responseIncludes": { "results": [], "warnings": [{ "code": "invalid_rows_dropped", "provider": "exa", "count": 3 }] } } },
    { "name": "missing results list", "call": "search", "query": "q", "options": { "provider": "exa" }, "responses": [{ "status": 200, "body": {} }], "expect": { "error": { "code": "invalid_response" } } },
    { "name": "results is an object", "call": "search", "query": "q", "options": { "provider": "tavily" }, "responses": [{ "status": 200, "body": { "results": {} } }], "expect": { "error": { "code": "invalid_response" } } },
    { "name": "contents with every list empty marks each URL missing", "call": "contents", "urls": ["https://example.com/a"], "options": { "provider": "tinyfish" }, "responses": [{ "status": 200, "body": { "results": [], "errors": [] } }], "expect": { "responseIncludes": { "pages": [{ "url": "https://example.com/a", "status": "failed", "finalUrl": null, "title": null, "content": null, "publishedAt": null, "author": null, "error": { "code": "missing", "message": null } }] } } },
    { "name": "contents page returned for a URL that was not requested", "call": "contents", "urls": ["https://example.com/a"], "options": { "provider": "tinyfish" }, "responses": [{ "status": 200, "body": { "results": [{ "url": "https://example.com/a", "text": "A" }, { "url": "https://example.com/z", "text": "Z" }], "errors": [] } }], "expect": { "responseIncludes": { "warnings": [{ "code": "unmatched_pages", "provider": "tinyfish", "count": 1 }] } } },
    { "name": "contents URL matching ignores scheme and host case and a default port", "call": "contents", "urls": ["HTTPS://Example.COM:443"], "options": { "provider": "tinyfish" }, "responses": [{ "status": 200, "body": { "results": [{ "url": "https://example.com/", "text": "A" }], "errors": [] } }], "expect": { "responseIncludes": { "pages": [{ "url": "HTTPS://Example.COM:443", "status": "ok", "finalUrl": null, "title": null, "content": "A", "publishedAt": null, "author": null, "error": null }] } } }
  ]
}
