{
  "description": "Explicit fallback. The next provider is tried only after a failure whose code is in policy.fallbackOn, once the current provider's retries are spent. A provider that cannot express the request is skipped before anything is sent.",
  "defaults": { "options": { "provider": "exa", "fallback": ["tavily"] } },
  "cases": [
    {
      "name": "503 falls back",
      "call": "search", "query": "q",
      "responses": [{ "status": 503 }, { "status": 200, "body": { "results": [], "request_id": "t" } }],
      "expect": {
        "requests": [{ "url": "https://api.exa.ai/search" }, { "url": "https://api.tavily.com/search" }],
        "responseIncludes": {
          "provider": "tavily",
          "warnings": [{ "code": "fallback_used", "provider": "tavily" }],
          "attempts": [
            { "provider": "exa", "outcome": "error", "code": "unavailable", "status": 503, "startMs": 0, "durationMs": 0 },
            { "provider": "tavily", "outcome": "ok", "status": 200, "startMs": 0, "durationMs": 0 }
          ]
        }
      }
    },
    { "name": "429 falls back", "call": "search", "query": "q", "responses": [{ "status": 429 }, { "status": 200, "body": { "results": [] } }], "expect": { "responseIncludes": { "provider": "tavily" } } },
    { "name": "network failure falls back", "call": "search", "query": "q", "responses": [{ "network": true }, { "status": 200, "body": { "results": [] } }], "expect": { "responseIncludes": { "provider": "tavily" } } },
    { "name": "402 (out of credits, not billed) falls back", "call": "search", "query": "q", "responses": [{ "status": 402 }, { "status": 200, "body": { "results": [] } }], "expect": { "responseIncludes": { "provider": "tavily" } } },
    { "name": "401 does not fall back", "call": "search", "query": "q", "responses": [{ "status": 401 }], "expect": { "requestCount": 1, "error": { "code": "auth", "provider": "exa" } } },
    { "name": "403 does not fall back", "call": "search", "query": "q", "responses": [{ "status": 403 }], "expect": { "requestCount": 1, "error": { "code": "forbidden", "provider": "exa" } } },
    { "name": "400 does not fall back", "call": "search", "query": "q", "responses": [{ "status": 400 }], "expect": { "requestCount": 1, "error": { "code": "provider_error", "provider": "exa" } } },
    { "name": "an unusable 200 does not fall back (it may have been billed)", "call": "search", "query": "q", "responses": [{ "status": 200, "bodyText": "nope" }], "expect": { "requestCount": 1, "error": { "code": "invalid_response", "provider": "exa" } } },
    {
      "name": "empty results do not fall back",
      "call": "search", "query": "q",
      "responses": [{ "status": 200, "body": { "results": [] } }],
      "expect": { "requestCount": 1, "responseIncludes": { "provider": "exa", "results": [], "warnings": [] } }
    },
    {
      "name": "retries are spent before falling back",
      "call": "search", "query": "q", "options": { "maxRetries": 1 }, "random": [0.5],
      "responses": [{ "status": 503 }, { "status": 503 }, { "status": 200, "body": { "results": [] } }],
      "expect": {
        "requests": [{ "url": "https://api.exa.ai/search" }, { "url": "https://api.exa.ai/search" }, { "url": "https://api.tavily.com/search" }],
        "responseIncludes": { "provider": "tavily", "latencyMs": 187 }
      }
    },
    {
      "name": "a chain that runs out returns the last error",
      "call": "search", "query": "q",
      "responses": [{ "status": 503 }, { "status": 429 }],
      "expect": {
        "error": {
          "code": "rate_limit", "provider": "tavily",
          "attempts": [
            { "provider": "exa", "outcome": "error", "code": "unavailable", "status": 503, "startMs": 0, "durationMs": 0 },
            { "provider": "tavily", "outcome": "error", "code": "rate_limit", "status": 429, "startMs": 0, "durationMs": 0 }
          ]
        }
      }
    },
    {
      "name": "an unsupported option skips the provider without sending",
      "call": "search", "query": "q", "options": { "language": "fr" },
      "responses": [{ "status": 200, "body": { "results": [] } }],
      "expect": {
        "requests": [{ "url": "https://api.tavily.com/search", "bodyIncludes": { "language": "fr" } }],
        "responseIncludes": {
          "provider": "tavily",
          "warnings": [{ "code": "fallback_used", "provider": "tavily" }],
          "attempts": [
            { "provider": "exa", "outcome": "skipped", "code": "unsupported", "startMs": 0, "durationMs": 0 },
            { "provider": "tavily", "outcome": "ok", "status": 200, "startMs": 0, "durationMs": 0 }
          ]
        }
      }
    },
    {
      "name": "a provider limit skips the provider",
      "call": "search", "query": "q", "options": { "provider": "tavily", "fallback": ["exa"], "maxResults": 50 },
      "responses": [{ "status": 200, "body": { "results": [] } }],
      "expect": { "requests": [{ "url": "https://api.exa.ai/search", "bodyIncludes": { "numResults": 50 } }], "responseIncludes": { "provider": "exa" } }
    },
    {
      "name": "a country the provider cannot name skips it",
      "call": "search", "query": "q", "options": { "provider": "tavily", "fallback": ["exa"], "country": "XK" },
      "responses": [{ "status": 200, "body": { "results": [] } }],
      "expect": { "requests": [{ "url": "https://api.exa.ai/search", "bodyIncludes": { "userLocation": "XK" } }] }
    },
    {
      "name": "when every provider is skipped the call is unsupported",
      "call": "search", "query": "q", "options": { "provider": "exa", "fallback": ["context"], "language": "de", "depth": "deep" },
      "responses": [],
      "expect": {
        "requestCount": 0,
        "error": {
          "code": "unsupported", "provider": "context", "field": "depth",
          "attempts": [
            { "provider": "exa", "outcome": "skipped", "code": "unsupported", "startMs": 0, "durationMs": 0 },
            { "provider": "context", "outcome": "skipped", "code": "unsupported", "startMs": 0, "durationMs": 0 }
          ]
        }
      }
    },
    {
      "name": "provider options apply only to their provider",
      "call": "search", "query": "q", "options": { "providerOptions": { "exa": { "category": "news" }, "tavily": { "topic": "news" } } },
      "responses": [{ "status": 503 }, { "status": 200, "body": { "results": [] } }],
      "expect": {
        "requests": [
          { "url": "https://api.exa.ai/search", "bodyIncludes": { "category": "news" } },
          { "url": "https://api.tavily.com/search", "bodyIncludes": { "topic": "news" } }
        ]
      }
    },
    {
      "name": "the provider can be chosen per call",
      "call": "search", "query": "q", "client": { "provider": "exa" }, "options": { "provider": "tinyfish", "fallback": [] },
      "responses": [{ "status": 200, "body": { "query": "q", "results": [] } }],
      "expect": { "requests": [{ "method": "GET", "url": "https://api.search.tinyfish.ai?query=q" }], "responseIncludes": { "provider": "tinyfish" } }
    }
  ]
}
