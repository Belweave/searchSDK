{
  "description": "HTTP status mapping, unusable bodies and transport failures. Provider-specific codes are in providers/*.json.",
  "defaults": { "options": { "provider": "exa" } },
  "cases": [
    { "name": "400", "call": "search", "query": "q", "responses": [{ "status": 400, "body": { "requestId": "r", "error": "e", "tag": "INVALID_REQUEST_BODY" } }], "expect": { "error": { "code": "provider_error", "status": 400, "providerCode": "INVALID_REQUEST_BODY" } } },
    { "name": "401", "call": "search", "query": "q", "responses": [{ "status": 401, "body": { "requestId": "r", "error": "e", "tag": "INVALID_API_KEY" } }], "expect": { "error": { "code": "auth", "status": 401 } } },
    { "name": "402", "call": "search", "query": "q", "responses": [{ "status": 402 }], "expect": { "error": { "code": "quota", "status": 402 } } },
    { "name": "403", "call": "search", "query": "q", "responses": [{ "status": 403 }], "expect": { "error": { "code": "forbidden", "status": 403 } } },
    { "name": "404", "call": "search", "query": "q", "responses": [{ "status": 404 }], "expect": { "error": { "code": "provider_error", "status": 404 } } },
    { "name": "408", "call": "search", "query": "q", "responses": [{ "status": 408 }], "expect": { "error": { "code": "unavailable", "status": 408 } } },
    { "name": "409", "call": "search", "query": "q", "responses": [{ "status": 409 }], "expect": { "error": { "code": "provider_error", "status": 409 } } },
    { "name": "418", "call": "search", "query": "q", "responses": [{ "status": 418 }], "expect": { "error": { "code": "provider_error", "status": 418 } } },
    { "name": "422", "call": "search", "query": "q", "responses": [{ "status": 422 }], "expect": { "error": { "code": "provider_error", "status": 422 } } },
    { "name": "429", "call": "search", "query": "q", "responses": [{ "status": 429 }], "expect": { "error": { "code": "rate_limit", "status": 429 } } },
    { "name": "500 with an HTML body", "call": "search", "query": "q", "responses": [{ "status": 500, "bodyText": "<html>oops</html>" }], "expect": { "error": { "code": "unavailable", "status": 500 } } },
    { "name": "502", "call": "search", "query": "q", "responses": [{ "status": 502 }], "expect": { "error": { "code": "unavailable", "status": 502 } } },
    { "name": "503", "call": "search", "query": "q", "responses": [{ "status": 503, "body": { "requestId": "r", "error": "e", "tag": "SERVICE_OVERLOADED" } }], "expect": { "error": { "code": "unavailable", "status": 503, "providerCode": "SERVICE_OVERLOADED" } } },
    { "name": "504", "call": "search", "query": "q", "responses": [{ "status": 504 }], "expect": { "error": { "code": "unavailable", "status": 504 } } },
    { "name": "599", "call": "search", "query": "q", "responses": [{ "status": 599 }], "expect": { "error": { "code": "unavailable", "status": 599 } } },
    { "name": "redirects are not followed", "call": "search", "query": "q", "responses": [{ "status": 302, "headers": { "location": "https://elsewhere.example/" } }], "expect": { "requestCount": 1, "error": { "code": "invalid_response", "status": 302 } } },
    { "name": "304", "call": "search", "query": "q", "responses": [{ "status": 304 }], "expect": { "error": { "code": "invalid_response", "status": 304 } } },
    { "name": "provider code that is not a string is ignored", "call": "search", "query": "q", "responses": [{ "status": 400, "body": { "tag": 7 } }], "expect": { "error": { "code": "provider_error", "status": 400, "providerCode": null } } },
    { "name": "200 with malformed JSON", "call": "search", "query": "q", "responses": [{ "status": 200, "bodyText": "{\"results\": [" }], "expect": { "error": { "code": "invalid_response", "status": 200 } } },
    { "name": "200 with an empty body", "call": "search", "query": "q", "responses": [{ "status": 200, "bodyText": "" }], "expect": { "error": { "code": "invalid_response" } } },
    { "name": "204", "call": "search", "query": "q", "responses": [{ "status": 204 }], "expect": { "error": { "code": "invalid_response" } } },
    { "name": "200 with invalid UTF-8", "call": "search", "query": "q", "responses": [{ "status": 200, "bodyBase64": "eyJyZXN1bHRzIjpbXSwieCI6Iv8ifQ==" }], "expect": { "error": { "code": "invalid_response" } } },
    { "name": "200 with a UTF-8 byte order mark is accepted", "call": "search", "query": "q", "responses": [{ "status": 200, "bodyBase64": "77u/eyJyZXN1bHRzIjpbXX0=" }], "expect": { "responseIncludes": { "results": [] } } },
    {
      "name": "200 without a results array is invalid and keeps the paid body",
      "call": "search",
      "query": "q",
      "responses": [{ "status": 200, "body": { "results": null, "costDollars": { "total": 0.007 } } }],
      "expect": {
        "error": {
          "code": "invalid_response",
          "provider": "exa",
          "raw": { "results": null, "costDollars": { "total": 0.007 } },
          "attempts": [{ "provider": "exa", "outcome": "error", "code": "invalid_response", "status": 200, "startMs": 0, "durationMs": 0, "billed": "yes", "cost": { "usd": 0.007, "estimated": true, "source": "reported" } }]
        }
      }
    },
    { "name": "network failure", "call": "search", "query": "q", "responses": [{ "network": true }], "expect": { "error": { "code": "network", "provider": "exa", "attempts": [{ "provider": "exa", "outcome": "error", "code": "network", "startMs": 0, "durationMs": 0, "billed": "possible", "cost": { "usd": 0.007, "estimated": true, "source": "computed" } }] } } },
    { "name": "error messages are fixed and carry no key or body", "call": "search", "query": "q", "client": { "keys": { "exa": "secret-key-must-not-leak" } }, "responses": [{ "status": 401, "body": { "error": "Your key secret-key-must-not-leak is invalid" } }], "expect": { "error": { "code": "auth", "message": "The provider rejected the API key." }, "secretAbsent": "secret-key-must-not-leak" } }
  ]
}
