          "bodyText": "{\"requestId\":\"r1\",\"results\":[{\"url\":\"https://a.example/\",\"title\":\"A\",\"highlights\":[\"h\"]},{\"url\":\"https://b.example/\",\"id\":\"x\"}],\"costDollars\":{\"total\":0.007}}"
