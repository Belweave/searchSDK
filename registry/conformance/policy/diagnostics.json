    {
      "name": "contents: per-source list, where and field resolution; skipped attempts are not reported but keep their index",
      "call": "contents",
      "urls": [
        "https://example.com/a",
        "https://example.com/b"
      ],
      "options": {
        "provider": "brave",
        "fallback": [
          "exa"
        ]
      },
      "client": {
        "diagnostics": true
      },
      "responses": [
        {
          "status": 200,
          "bodyText": "{\"results\":[{\"url\":\"https://example.com/a\",\"text\":\"A\"},{\"text\":\"no url\"}],\"statuses\":[{\"id\":\"https://example.com/b\",\"status\":\"error\",\"error\":{\"tag\":\"CRAWL_NOT_FOUND\"}},{\"id\":\"https://example.com/a\",\"status\":\"success\"}]}"
