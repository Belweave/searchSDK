{
  "name": "@searchsdk/mcp",
  "version": "0.1.0",
  "description": "A local MCP server for searchSDK: its docs and provider registry, plus web search and page contents through your own provider keys.",
  "license": "MIT",
  "type": "module",
  "bin": { "searchsdk-mcp": "dist/cli.js" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": { "node": ">=24.22.1" },
  "scripts": {
    "corpus": "node scripts/corpus.mjs --write",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/corpus.mjs --check && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node scripts/corpus.mjs --check && tsc -p tsconfig.json && node --test --test-concurrency=1 --import ./test/guard.ts \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@searchsdk/sdk": "^0.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  },
  "publishConfig": { "access": "public" },
  "homepage": "https://searchsdk.dev/docs/mcp",
  "keywords": ["mcp", "model context protocol", "mcp server", "search", "web search", "search api", "ai agents", "llm", "searchsdk"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Belweave/searchSDK.git",
    "directory": "sdk/mcp"
  }
}
