{
  "name": "searchsdk",
  "version": "0.0.0",
  "description": "One interface to many web search providers, driven by a shared provider registry.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=24.22.1" },
  "scripts": {
    "sync": "node scripts/sync-registry.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/sync-registry.mjs --check && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node scripts/sync-registry.mjs --check && tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit && node --test --test-concurrency=1 --import ./test/guard.ts \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Belweave/searchSDK.git",
    "directory": "sdk/typescript"
  }
}
