{
  "$description": "searchSDK design tokens, the source of truth. Edit here, then run `npm run build` in brand/. Colours are authored in OKLCH; $value is the sRGB hex that OKLCH maps to, and the check fails if they disagree. References use {group.name}.",
  "color": {
    "$type": "color",
    "brand": {
      "apricot": { "$value": "#FF9C3F", "oklch": "oklch(0.78 0.16 60)", "$description": "Top band of the mark. Primary action." },
      "violet": { "$value": "#823BFA", "oklch": "oklch(0.56 0.26 293)", "$description": "Middle band, where the sources meet. Selection; focus on light surfaces." },
      "cyan": { "$value": "#00F4FE", "oklch": "oklch(0.88 0.15 200)", "$description": "Bottom band. Focus on dark surfaces." }
    },
    "brand-paper": {
      "$description": "The mark on light surfaces. Apricot and cyan are deepened so every band holds at least 2:1 against paper; violet is unchanged.",
      "apricot": { "$value": "#F3821D", "oklch": "oklch(0.72 0.17 55)" },
      "violet": { "$value": "#823BFA", "oklch": "oklch(0.56 0.26 293)" },
      "cyan": { "$value": "#00C0D7", "oklch": "oklch(0.74 0.13 210)" }
    },
    "ink": {
      "$description": "Cool neutral, hue 280. Dark surfaces and text on light surfaces. 900 is the page.",
      "50": { "$value": "#F6F6F9", "oklch": "oklch(0.975 0.003 280)" },
      "100": { "$value": "#EAEBEE", "oklch": "oklch(0.94 0.005 280)" },
      "200": { "$value": "#D6D7DC", "oklch": "oklch(0.88 0.007 280)" },
      "300": { "$value": "#B9BAC2", "oklch": "oklch(0.79 0.011 280)" },
      "400": { "$value": "#9697A2", "oklch": "oklch(0.68 0.015 280)" },
      "500": { "$value": "#72747F", "oklch": "oklch(0.56 0.018 280)" },
      "600": { "$value": "#50525E", "oklch": "oklch(0.44 0.02 280)" },
      "700": { "$value": "#333440", "oklch": "oklch(0.33 0.021 280)" },
      "750": { "$value": "#252732", "oklch": "oklch(0.275 0.02 280)" },
      "800": { "$value": "#1C1D27", "oklch": "oklch(0.235 0.018 280)" },
      "850": { "$value": "#14151D", "oklch": "oklch(0.2 0.016 280)" },
      "900": { "$value": "#0E0F15", "oklch": "oklch(0.17 0.014 280)" },
      "950": { "$value": "#090A10", "oklch": "oklch(0.145 0.013 280)" },
      "1000": { "$value": "#05050A", "oklch": "oklch(0.12 0.012 280)" }
    },
    "paper": {
      "$description": "Warm neutral, hue 85. Light surfaces only. 50 is the page.",
      "0": { "$value": "#FEFDFC", "oklch": "oklch(0.995 0.002 85)" },
      "50": { "$value": "#FAF9F6", "oklch": "oklch(0.982 0.004 85)" },
      "100": { "$value": "#F4F2EE", "oklch": "oklch(0.962 0.006 85)" },
      "200": { "$value": "#ECE9E4", "oklch": "oklch(0.935 0.008 85)" },
      "300": { "$value": "#E1DED7", "oklch": "oklch(0.9 0.01 85)" },
      "400": { "$value": "#D1CDC5", "oklch": "oklch(0.85 0.012 85)" }
    }
  },
  "theme": {
    "$description": "Semantic roles. Dark is the default; light is opt-in. Names match the site's tokens.",
    "dark": {
      "surface-0": "{color.ink.900}",
      "surface-1": "{color.ink.850}",
      "surface-2": "{color.ink.800}",
      "surface-3": "{color.ink.750}",
      "well": "{color.ink.950}",
      "edge": "{color.ink.1000}",
      "edge-lit": "{color.ink.700}",
      "line": "{color.ink.750}",
      "line-strong": "{color.ink.500}",
      "fg": "{color.ink.50}",
      "fg-muted": "{color.ink.300}",
      "fg-subtle": "{color.ink.400}",
      "accent": "{color.brand.apricot}",
      "accent-strong": { "$value": "#FFBB74", "oklch": "oklch(0.84 0.14 66)" },
      "accent-text": "{color.brand.apricot}",
      "on-accent": "{color.ink.900}",
      "focus": "{color.brand.cyan}",
      "selection": "{color.brand.violet}",
      "ok": { "$value": "#6FE79F", "oklch": "oklch(0.84 0.15 155)" },
      "warn": { "$value": "#FFB24F", "oklch": "oklch(0.82 0.15 70)" },
      "danger": { "$value": "#FF716B", "oklch": "oklch(0.72 0.18 25)" },
      "sample": { "$value": "#EFDD71", "oklch": "oklch(0.89 0.13 100)" },
      "on-state": "{color.ink.900}",
      "mark-apricot": "{color.brand.apricot}",
      "mark-violet": "{color.brand.violet}",
      "mark-cyan": "{color.brand.cyan}",
      "code-keyword": { "$value": "#B5A0FF", "oklch": "oklch(0.76 0.15 293)" },
      "code-string": { "$value": "#6DE8E7", "oklch": "oklch(0.86 0.11 195)" },
      "code-number": { "$value": "#FFB573", "oklch": "oklch(0.83 0.13 62)" },
      "code-function": { "$value": "#94D3FF", "oklch": "oklch(0.84 0.09 240)" },
      "code-type": { "$value": "#E6A4E0", "oklch": "oklch(0.8 0.11 330)" }
    },
    "light": {
      "surface-0": "{color.paper.50}",
      "surface-1": "{color.paper.0}",
      "surface-2": "{color.paper.100}",
      "surface-3": "{color.paper.200}",
      "well": "{color.paper.100}",
      "edge": "{color.paper.400}",
      "edge-lit": "{color.paper.0}",
      "line": "{color.paper.300}",
      "line-strong": "{color.ink.500}",
      "fg": "{color.ink.900}",
      "fg-muted": "{color.ink.700}",
      "fg-subtle": "{color.ink.600}",
      "accent": "{color.brand-paper.apricot}",
      "accent-strong": { "$value": "#E06D00", "oklch": "oklch(0.66 0.17 52)" },
      "accent-text": { "$value": "#A74900", "oklch": "oklch(0.52 0.15 48)" },
      "on-accent": "{color.ink.900}",
      "focus": "{color.brand.violet}",
      "selection": "{color.brand.violet}",
      "ok": { "$value": "#007440", "oklch": "oklch(0.49 0.13 155)" },
      "warn": { "$value": "#955400", "oklch": "oklch(0.51 0.13 62)" },
      "danger": { "$value": "#BE222A", "oklch": "oklch(0.52 0.19 25)" },
      "sample": { "$value": "#716400", "oklch": "oklch(0.5 0.11 100)" },
      "on-state": "{color.paper.50}",
      "mark-apricot": "{color.brand-paper.apricot}",
      "mark-violet": "{color.brand-paper.violet}",
      "mark-cyan": "{color.brand-paper.cyan}",
      "code-keyword": { "$value": "#6E37D2", "oklch": "oklch(0.5 0.22 293)" },
      "code-string": { "$value": "#006E77", "oklch": "oklch(0.49 0.09 205)" },
      "code-number": { "$value": "#A34700", "oklch": "oklch(0.51 0.14 48)" },
      "code-function": { "$value": "#1A609E", "oklch": "oklch(0.48 0.12 250)" },
      "code-type": { "$value": "#9A3289", "oklch": "oklch(0.5 0.17 335)" }
    }
  },
  "contrast": {
    "$description": "Enforced minimum WCAG 2 ratios, checked in both themes by `npm run check`. [foreground, background, minimum].",
    "rules": [
      ["fg", "surface-0", 7],
      ["fg", "surface-1", 7],
      ["fg", "surface-2", 7],
      ["fg-muted", "surface-0", 4.5],
      ["fg-muted", "surface-1", 4.5],
      ["fg-muted", "surface-2", 4.5],
      ["fg-subtle", "surface-0", 4.5],
      ["fg-subtle", "surface-1", 4.5],
      ["fg-subtle", "surface-2", 4.5],
      ["accent-text", "surface-0", 4.5],
      ["accent-text", "surface-1", 4.5],
      ["accent-text", "surface-2", 4.5],
      ["on-accent", "accent", 4.5],
      ["on-accent", "accent-strong", 4.5],
      ["ok", "surface-0", 4.5],
      ["warn", "surface-0", 4.5],
      ["danger", "surface-0", 4.5],
      ["sample", "surface-0", 4.5],
      ["ok", "surface-2", 4.5],
      ["warn", "surface-2", 4.5],
      ["danger", "surface-2", 4.5],
      ["sample", "surface-2", 4.5],
      ["on-state", "ok", 4.5],
      ["on-state", "warn", 4.5],
      ["on-state", "danger", 4.5],
      ["on-state", "sample", 4.5],
      ["code-keyword", "well", 4.5],
      ["code-string", "well", 4.5],
      ["code-number", "well", 4.5],
      ["code-function", "well", 4.5],
      ["code-type", "well", 4.5],
      ["fg-subtle", "well", 4.5],
      ["line-strong", "surface-0", 3],
      ["focus", "surface-0", 3],
      ["focus", "surface-2", 3],
      ["mark-violet", "surface-0", 2],
      ["mark-apricot", "surface-0", 2],
      ["mark-cyan", "surface-0", 2]
    ]
  },
  "font": {
    "sans": { "$type": "fontFamily", "$value": ["Instrument Sans", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Headings and prose. Variable: weight 400–700, width 75–100." },
    "mono": { "$type": "fontFamily", "$value": ["Martian Mono", "ui-monospace", "monospace"], "$description": "Code, numbers, units and benchmark figures. Variable: weight 100–800, width 75–112.5." }
  },
  "type": {
    "size": {
      "label": "0.6875rem",
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.375rem",
      "2xl": "1.75rem",
      "3xl": "clamp(2rem, 4.2vw, 3.25rem)",
      "h2": "clamp(2.25rem, 5vw, 4.25rem)",
      "display": "clamp(3rem, 8.4vw, 7rem)",
      "lead": "clamp(1.125rem, 1.5vw, 1.375rem)",
      "readout": "clamp(2rem, 4vw, 3.25rem)"
    },
    "leading": { "display": "0.94", "tight": "1.04", "snug": "1.3", "normal": "1.6" },
    "weight": { "regular": "400", "medium": "500", "semibold": "600", "display": "650" },
    "tracking": { "display": "-0.035em", "tight": "-0.022em", "normal": "0", "wide": "0.04em", "label": "0.06em" },
    "mono-stretch": { "$value": "87.5%", "$description": "Martian Mono's narrower width, for labels and readouts in tight columns." }
  },
  "space": {
    "unit": "0.25rem",
    "scale": { "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "6": "1.5rem", "8": "2rem", "12": "3rem", "16": "4rem", "24": "6rem", "32": "8rem" },
    "gutter": "clamp(1rem, 4vw, 2.5rem)",
    "section": "clamp(4.5rem, 10vw, 8.5rem)",
    "page-max": "76rem",
    "measure": "38rem"
  },
  "radius": {
    "$description": "Hard, like the mark. The app icon tile is the only large rounding.",
    "sm": "0.125rem",
    "md": "0.25rem",
    "lg": "0.5rem"
  },
  "focus": { "width": "2px", "offset": "3px" },
  "motion": {
    "duration": {
      "instant": "80ms",
      "fast": "140ms",
      "base": "220ms",
      "slow": "400ms",
      "reveal": "640ms",
      "settle": "1000ms",
      "stagger": "60ms",
      "blink": "1s",
      "mark-band": "480ms",
      "mark-loop": "2400ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.7, 0, 0.84, 0)"
    },
    "distance": { "reveal": "16px" }
  }
}
