{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bench/schemas/results-1.schema.json",
  "title": "searchSDK Benchmarks results, version 1",
  "$comment": "Scores, URLs, hashes, timings, costs and settings only. Never response or page text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshot",
    "mode",
    "liveVerified",
    "method",
    "generatedAt",
    "run",
    "datasets",
    "privateSet",
    "registry",
    "judging",
    "judge",
    "checkJudge",
    "conditions",
    "agreement",
    "ranking",
    "pages",
    "providers",
    "tuning",
    "items"
  ],
  "$defs": {
    "interval": {
      "type": "object",
      "required": [
        "mean",
        "ci95"
      ],
      "additionalProperties": false,
      "properties": {
        "mean": {
          "type": "number"
        },
        "ci95": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "depth": {
          "enum": [
            "fast",
            "standard",
            "deep"
          ]
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "providerOptions": {
          "type": "object"
        }
      }
    },
    "intervalN": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mean",
        "ci95",
        "n"
      ],
      "properties": {
        "mean": {
          "type": "number"
        },
        "ci95": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "n": {
          "type": "integer"
        }
      }
    }
  },
  "properties": {
    "snapshot": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "live",
        "fixture"
      ]
    },
    "liveVerified": {
      "type": "boolean"
    },
    "method": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generatedAt": {
      "type": "string"
    },
    "schema": {
      "const": "bench-results/1"
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "startedAt",
        "finishedAt",
        "harnessGit",
        "region",
        "host"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "startedAt": {
          "type": "string"
        },
        "finishedAt": {
          "type": "string"
        },
        "harnessGit": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "host": {
          "type": "object"
        }
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "sha256",
          "count"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "count": {
            "type": "integer"
          }
        }
      }
    },
    "privateSet": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "version",
            "count"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "string"
            },
            "count": {
              "type": "integer"
            }
          }
        }
      ]
    },
    "registry": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "specVersion"
        ],
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string"
          },
          "specVersion": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "judging": {
      "type": "string",
      "enum": [
        "judged",
        "not judged (--no-judge)",
        "no judged items"
      ]
    },
    "judge": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "id",
            "model",
            "rubric",
            "rubricSha256",
            "promptSha256",
            "params"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "rubric": {
              "type": "string"
            },
            "rubricSha256": {
              "type": "string"
            },
            "promptSha256": {
              "type": "string"
            },
            "params": {
              "type": "object"
            }
          }
        }
      ]
    },
    "checkJudge": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "id",
            "model",
            "rubric",
            "rubricSha256",
            "promptSha256",
            "params"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "rubric": {
              "type": "string"
            },
            "rubricSha256": {
              "type": "string"
            },
            "promptSha256": {
              "type": "string"
            },
            "params": {
              "type": "object"
            }
          }
        }
      ]
    },
    "conditions": {
      "type": "object"
    },
    "agreement": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "pairs",
            "judged",
            "unresolved",
            "selfKappa",
            "crossKappa",
            "humanKappa",
            "humanExact",
            "judgedPublished",
            "gate"
          ],
          "additionalProperties": false,
          "properties": {
            "pairs": {
              "type": "integer"
            },
            "judged": {
              "type": "integer"
            },
            "unresolved": {
              "type": "integer"
            },
            "selfKappa": {
              "type": [
                "object",
                "null"
              ]
            },
            "crossKappa": {
              "type": [
                "object",
                "null"
              ]
            },
            "humanKappa": {
              "type": [
                "object",
                "null"
              ]
            },
            "humanExact": {
              "type": [
                "number",
                "null"
              ]
            },
            "judgedPublished": {
              "type": "boolean"
            },
            "gate": {
              "type": "string"
            }
          }
        }
      ]
    },
    "ranking": {
      "type": "object",
      "required": [
        "rule",
        "floor",
        "minSeparation",
        "pairedItems",
        "droppedItems"
      ],
      "additionalProperties": false,
      "properties": {
        "rule": {
          "type": "string"
        },
        "floor": {
          "type": "number"
        },
        "minSeparation": {
          "type": "number"
        },
        "pairedItems": {
          "type": "object"
        },
        "droppedItems": {
          "type": "object"
        }
      }
    },
    "pages": {
      "description": "The page check: distinct top URLs the harness's own fetcher tried, how many it could read, and why the rest were unreadable. An unreadable page counts the same for every provider.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "urls",
        "read",
        "unreadable",
        "unreadableRate",
        "reasons"
      ],
      "properties": {
        "urls": {
          "type": "integer",
          "minimum": 0
        },
        "read": {
          "type": "integer",
          "minimum": 0
        },
        "unreadable": {
          "type": "integer",
          "minimum": 0
        },
        "unreadableRate": {
          "type": [
            "number",
            "null"
          ]
        },
        "reasons": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "name",
          "profile",
          "settings",
          "status",
          "n",
          "knownAnswer",
          "components",
          "judged",
          "judgedCheck",
          "reliability",
          "latencyMs",
          "cost",
          "excerptKind",
          "pageUnreadableRate",
          "stale",
          "retest",
          "rank"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "settings": {
            "$ref": "#/$defs/settings"
          },
          "status": {
            "enum": [
              "scored",
              "incomplete"
            ]
          },
          "n": {
            "type": "integer"
          },
          "knownAnswer": {
            "$ref": "#/$defs/interval"
          },
          "components": {
            "type": "object",
            "required": [
              "snippet",
              "page",
              "nav"
            ],
            "additionalProperties": false,
            "properties": {
              "snippet": {
                "type": [
                  "number"
                ]
              },
              "page": {
                "type": "number"
              },
              "nav": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "judged": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "mean",
                  "ci95",
                  "n",
                  "pageShare"
                ],
                "additionalProperties": false,
                "properties": {
                  "mean": {
                    "type": "number"
                  },
                  "ci95": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  },
                  "n": {
                    "type": "integer"
                  },
                  "pageShare": {
                    "type": "number"
                  }
                }
              }
            ]
          },
          "judgedCheck": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "mean",
                  "ci95",
                  "n"
                ],
                "additionalProperties": false,
                "properties": {
                  "mean": {
                    "type": "number"
                  },
                  "ci95": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  },
                  "n": {
                    "type": "integer"
                  }
                }
              }
            ]
          },
          "reliability": {
            "type": "object",
            "required": [
              "usableRate",
              "ci95",
              "attempts",
              "rates"
            ],
            "additionalProperties": false,
            "properties": {
              "usableRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "ci95": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "attempts": {
                "type": "integer"
              },
              "rates": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              }
            }
          },
          "latencyMs": {
            "type": "object",
            "required": [
              "n",
              "p50",
              "p90",
              "p95",
              "censoredAtMs",
              "timeouts"
            ],
            "additionalProperties": false,
            "properties": {
              "n": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "p50": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "p90": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "p95": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "censoredAtMs": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "timeouts": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "cost": {
            "type": "object",
            "required": [
              "attempts",
              "totalUsd",
              "perQueryUsd",
              "perCorrectUsd",
              "known",
              "unknownAttempts",
              "sources",
              "billed"
            ],
            "additionalProperties": false,
            "properties": {
              "attempts": {
                "type": "integer"
              },
              "totalUsd": {
                "type": "number"
              },
              "perQueryUsd": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "perCorrectUsd": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "known": {
                "type": "boolean"
              },
              "unknownAttempts": {
                "type": "integer"
              },
              "sources": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "billed": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              }
            }
          },
          "excerptKind": {
            "description": "What the provider's excerpts are (registry response.excerptKind); snippet credit depends on it.",
            "enum": [
              "description",
              "content-chunk",
              "highlights",
              "none",
              null
            ]
          },
          "pageUnreadableRate": {
            "type": [
              "number",
              "null"
            ]
          },
          "stale": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "n",
                  "rate"
                ],
                "additionalProperties": false,
                "properties": {
                  "n": {
                    "type": "integer"
                  },
                  "rate": {
                    "type": "number"
                  }
                }
              }
            ]
          },
          "retest": {
            "type": [
              "object",
              "null"
            ]
          },
          "rank": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "group",
                  "tied",
                  "reliable",
                  "position"
                ],
                "additionalProperties": false,
                "properties": {
                  "group": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "tied": {
                    "type": "boolean"
                  },
                  "reliable": {
                    "type": "boolean"
                  },
                  "position": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            ]
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "class",
          "split"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^((pub|fresh)-[a-z0-9-]+|sha256:[0-9a-f]{64})$"
          },
          "class": {
            "type": "string"
          },
          "split": {
            "enum": [
              "public",
              "private",
              "fresh"
            ]
          }
        }
      }
    },
    "tuning": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "selection",
            "rule",
            "split",
            "condition",
            "providers"
          ],
          "$comment": "The tuned column (METHOD §8): informational, beside the default headline; never the rank.",
          "properties": {
            "status": {
              "const": "selected"
            },
            "selection": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "runId",
                "mode",
                "createdAt",
                "sha256",
                "tuningConfigSha256"
              ],
              "properties": {
                "runId": {
                  "type": "string"
                },
                "mode": {
                  "enum": [
                    "live",
                    "fixture"
                  ]
                },
                "createdAt": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "tuningConfigSha256": {
                  "type": "string"
                }
              }
            },
            "rule": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "splitItems",
                "passes",
                "maxCandidates",
                "maxCostPerCallUsd",
                "minGain",
                "requireSeparation",
                "judged",
                "conditionItems",
                "conditionPasses"
              ],
              "properties": {
                "splitItems": {
                  "type": "integer"
                },
                "passes": {
                  "type": "integer"
                },
                "maxCandidates": {
                  "type": "integer"
                },
                "maxCostPerCallUsd": {
                  "type": "number"
                },
                "minGain": {
                  "type": "number"
                },
                "requireSeparation": {
                  "type": "boolean"
                },
                "judged": {
                  "const": false
                },
                "conditionItems": {
                  "type": "integer"
                },
                "conditionPasses": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              }
            },
            "split": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "files",
                "seed",
                "n",
                "itemsSha256",
                "disjointFromScored"
              ],
              "properties": {
                "files": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "seed": {
                  "type": "integer"
                },
                "n": {
                  "type": "integer"
                },
                "itemsSha256": {
                  "type": "string"
                },
                "disjointFromScored": {
                  "const": true
                }
              }
            },
            "condition": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "items",
                "passes"
              ],
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "passes": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              }
            },
            "providers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "provider",
                  "chosen",
                  "settings",
                  "reason",
                  "costBoundUsd",
                  "capUsd",
                  "default",
                  "tuned",
                  "sameItemsDefault",
                  "gain",
                  "evidence",
                  "rejected"
                ],
                "properties": {
                  "provider": {
                    "type": "string"
                  },
                  "chosen": {
                    "type": "string"
                  },
                  "settings": {
                    "$ref": "#/$defs/settings"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "costBoundUsd": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "capUsd": {
                    "type": "number"
                  },
                  "default": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/$defs/intervalN"
                      }
                    ]
                  },
                  "tuned": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/$defs/intervalN"
                      }
                    ]
                  },
                  "sameItemsDefault": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/$defs/intervalN"
                      }
                    ]
                  },
                  "gain": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/$defs/interval"
                      }
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "profile",
                        "settings",
                        "costBoundUsd",
                        "n",
                        "knownAnswer",
                        "gain",
                        "usableRate",
                        "eligible",
                        "reason"
                      ],
                      "properties": {
                        "profile": {
                          "type": "string"
                        },
                        "settings": {
                          "$ref": "#/$defs/settings"
                        },
                        "costBoundUsd": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "n": {
                          "type": "integer"
                        },
                        "knownAnswer": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "$ref": "#/$defs/interval"
                            }
                          ]
                        },
                        "gain": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "$ref": "#/$defs/interval"
                            }
                          ]
                        },
                        "usableRate": {
                          "type": "number"
                        },
                        "eligible": {
                          "type": "boolean"
                        },
                        "reason": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "rejected": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "settings",
                        "reason"
                      ],
                      "properties": {
                        "settings": {
                          "$ref": "#/$defs/settings"
                        },
                        "reason": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
