{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bench/schemas/item-1.schema.json",
  "title": "searchSDK Benchmarks dataset item, version 1",
  "type": "object",
  "required": ["id", "split", "class", "lang", "query", "answers", "answerPatterns", "answerUrls", "source", "licence", "asOf", "builder", "review"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^(pub|priv|fresh)-[a-z0-9-]{3,48}$" },
    "split": { "enum": ["public", "private", "fresh"] },
    "class": { "enum": ["fact.head", "fact.tail", "multihop", "tech", "nav", "nonen", "fresh"] },
    "lang": { "type": "string", "pattern": "^[a-z]{2}$" },
    "query": { "type": "string", "minLength": 3, "maxLength": 300 },
    "answers": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "answerPatterns": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "answerUrls": { "type": "array", "maxItems": 5, "items": { "type": "string", "pattern": "^https?://[^\\s/]+(/[^\\s]*)?$" } },
    "superseded": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1 } },
    "source": {
      "type": "object",
      "required": ["name", "url", "retrievedOn"],
      "additionalProperties": false,
      "properties": {
        "name": { "enum": ["wikidata"] },
        "url": { "type": "string", "pattern": "^https://" },
        "entity": { "type": "string", "pattern": "^Q[0-9]+$" },
        "path": { "type": "array", "items": { "type": "string", "pattern": "^[PQ][0-9]+$" } },
        "statement": { "type": "string" },
        "retrievedOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "licence": { "enum": ["CC0-1.0"] },
    "asOf": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "expires": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "builder": {
      "type": "object",
      "required": ["template", "version"],
      "additionalProperties": false,
      "properties": { "template": { "type": "string" }, "version": { "type": "string" } }
    },
    "review": {
      "type": "object",
      "required": ["status", "on"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["builder-checked", "agent-reviewed", "human-verified"] },
        "on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "note": { "type": "string" }
      }
    },
    "nonce": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
  }
}
